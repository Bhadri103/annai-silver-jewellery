FROM node:20-bookworm-slim
WORKDIR /app

ENV NODE_ENV=production
COPY annai-backend/package.json annai-backend/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY annai-backend/schema.sql ./schema.sql
COPY annai-backend/migrations ./migrations
COPY annai-backend/src ./src
COPY src /src

RUN mkdir -p /app/uploads && chown -R node:node /app /src
USER node

EXPOSE 3000
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "src/server.js"]
